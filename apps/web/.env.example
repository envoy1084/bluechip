# @bluechip/web. Copy to .env.local; never commit it. Vite exposes only VITE_ variables to the browser.

# `local` reads the Anvil fork at http://localhost:8545; `base` reads Base mainnet.
VITE_NETWORK=local
# The node `local` reads (http://localhost:8545 when unset).
# VITE_RPC_URL=http://localhost:8545
# Where the dev server proxies /api and /auth.
SERVER_ORIGIN=http://localhost:8080
