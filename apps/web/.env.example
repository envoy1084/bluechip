# @bluechip/web. Copy to .env.local; never commit it. Vite exposes only VITE_ variables to the browser.

# `local` is the local chain; `sepolia` is paper money on Base Sepolia; `base` is Base mainnet. The app reads the
# chain through the server's /api/rpc, and refuses a server on another network.
VITE_NETWORK=local
# Optional: the site's public origin for canonical URLs, link previews and the sitemap, when it isn't the network's
# own (https://bluechip.markets on base, https://paper.bluechip.markets on sepolia, http://localhost:3000 on local).
# Only base is indexed by search engines.
VITE_SITE_URL=
# Where the dev server proxies /api and /auth.
SERVER_ORIGIN=http://localhost:8080
# The server's public origin in a deployed build (https://api.bluechip.markets, https://paper-api.bluechip.markets):
# the browser calls it with the session cookie, and the server allows only this site's origin (its PUBLIC_ORIGIN).
# Empty for development, the browser suite and preview mode: the server's paths on the page's own origin.
VITE_API_URL=
# Optional: the app's site, when this build is the landing alone (https://paper.bluechip.markets on bluechip.markets
# until mainnet). Its ways in and every path of the app go there, it calls no API (leave VITE_API_URL empty) and sends
# no browser telemetry; a paper. app makes it say so beside its ways in and report its analytics as paper money's.
VITE_APP_URL=

# Product analytics (PostHog) and the browser's telemetry (OTLP to Axiom, through the server's /api/sync/*). Both run
# only in a paper or production build (VITE_NETWORK sepolia or base) with the project key and host set; never under
# `vite dev` or with ?preview. VITE_POSTHOG_HOST is PostHog's reverse proxy on our own domain.
VITE_POSTHOG_HOST=
VITE_POSTHOG_PROJECT_API_KEY=
# Optional: `paper` or `production`, when the deployment isn't the one VITE_NETWORK implies.
VITE_DEPLOYMENT_ENVIRONMENT=
