# The web app in production: the static build only (prerendered public pages, the SPA shell for every other path). The
# browser calls the server on its own domain (API_ORIGIN), so nothing here proxies. Traefik (Dokploy) terminates TLS in
# front, so this listens on plain HTTP. Settings from the image's build args: SITE_NETWORK (VITE_NETWORK: every network
# but `base` is kept out of search engines), API_ORIGIN (VITE_API_URL's origin), POSTHOG_HOST and APP_URL
# (VITE_APP_URL: this site is the landing alone, the app is there).
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Plain HTTP behind Traefik: no HTTP/3, which needs TLS.
		protocols h1 h2c
	}
}

:80 {
	# Every response: Traefik passes them through over HTTPS, where browsers honour HSTS.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@unindexed expression `"{$SITE_NETWORK:local}" != "base"`
	header @unindexed X-Robots-Tag "noindex, nofollow"

	handle /healthz {
		respond "ok" 200
	}

	# The landing alone (APP_URL set, until mainnet): a path with no file of its own would get the SPA shell, so it is a
	# page of the app (/home, /agents/*, /welcome, /recover, /signin, /dev/*), and goes to the same path and query on
	# the app's site (the browser keeps the hash). Temporary: at mainnet the app is here again. The landing, /help/*,
	# /legal/*, the crawler and agent files, the manifest and the images are files, and stay.
	@app {
		expression `"{$APP_URL:}" != ""`
		not path /healthz /assets/*
		not file {
			root /srv
			try_files {path} {path}/index.html
		}
	}
	handle @app {
		redir {$APP_URL:}{uri} 302
	}

	# Hashed build output: a missing chunk is a 404, never the shell (an old tab after a release reloads instead).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		# The app's own code only: TanStack's inline hydration scripts and inline styles (motion, Base UI), the
		# server on its own domain (API_ORIGIN: the API, its live stream, the chain through /api/rpc and telemetry
		# through /api/sync), and PostHog through its own reverse proxy (POSTHOG_HOST, from the VITE_POSTHOG_HOST
		# build arg), which also serves its scripts. Base Account (Coinbase's wallet SDK) talks to Coinbase from the
		# page and opens its keys in a popup.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' {$POSTHOG_HOST:}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:} {$POSTHOG_HOST:} https://*.coinbase.com wss://*.coinbase.com; frame-src https://*.coinbase.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Cross-Origin-Opener-Policy "same-origin-allow-popups"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}

		# Images and icons change rarely and keep their names: a day. Pages, the shell, the service worker, the
		# manifest and the crawler files are checked on every visit, so a release shows at once.
		@longLived path /og/* /favicon.ico /favicon.svg /apple-touch-icon.png /icon-*.png
		header @longLived Cache-Control "public, max-age=86400"
		@revalidated not path /og/* /favicon.ico /favicon.svg /apple-touch-icon.png /icon-*.png
		header @revalidated Cache-Control "no-cache"

		header /manifest.webmanifest Content-Type "application/manifest+json"
		# The public pages' Markdown twins, for agents (llms.txt).
		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"

		try_files {path} {path}/index.html /_shell.html
		file_server {
			precompressed br gzip
		}
	}
}
