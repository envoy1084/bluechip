{
  "name": "@bluechip/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "bluechip API server.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local src/bin/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev:fund": "node --env-file-if-exists=.env.local src/bin/dev-fund.ts",
    "jobs:dev": "trigger dev",
    "jobs:deploy": "trigger deploy",
    "jobs:login": "trigger login"
  },
  "dependencies": {
    "@bluechip/chain": "workspace:^",
    "@bluechip/domain": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "4.1.5",
    "@namera-ai/sdk": "catalog:",
    "@simplewebauthn/server": "14.1.0",
    "@trigger.dev/sdk": "4.8.10",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "catalog:",
    "typeid-js": "1.2.0",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@bluechip/devnet": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.6",
    "ox": "0.14.67",
    "trigger.dev": "4.8.10",
    "typescript": "catalog:"
  }
}
