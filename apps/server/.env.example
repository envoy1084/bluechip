# @bluechip/server. Copy to .env.local; never commit it. Every value below is the local default.
NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:3000
# The WebAuthn relying party: passkeys are bound to this domain for good. `localhost` in development.
RP_ID=localhost
LOG_LEVEL=Info
DATABASE_URL=postgres://bluechip:bluechip@localhost:5432/bluechip

# Network: `local` is the Anvil fork from `docker compose --profile chain up -d`; `base` is Base mainnet.
NETWORK=local
BASE_RPC_URL=http://localhost:8545

# Bundler: `local` (Alto at BUNDLER_URL) or `alchemy`.
BUNDLER=local
BUNDLER_URL=http://localhost:4337
# Who pays gas: `none` (the account, in ETH), `alchemy-bso` (Alchemy's bundler) or `alchemy-paymaster`.
GAS_SPONSORSHIP=none
# ALCHEMY_API_KEY=
# ALCHEMY_GAS_POLICY_ID=

# Trigger.dev: the project's ref (proj_…); log in once with `pnpm --filter @bluechip/server jobs:login`.
# TRIGGER_PROJECT_REF=
