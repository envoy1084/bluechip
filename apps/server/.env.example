# @bluechip/server. Copy to .env.local; never commit it. Every value below is the local default.
# Paper's and production's settings live in deploy/.env.paper and deploy/.env.production (deploy/README.md).
NODE_ENV=development
PORT=8080
# The web app's origin (https://bluechip.markets): passkeys are made on it, links in messages point at it, and only it
# may call the API from a browser (CORS, with the session cookie).
PUBLIC_ORIGIN=http://localhost:3000
# The WebAuthn relying party, the web app's domain (bluechip.markets): passkeys are bound to it for good. `localhost` in
# development.
RP_ID=localhost
# The server's own public origin (https://api.bluechip.markets), for the Telegram webhook. PUBLIC_ORIGIN when empty
# (development: Vite proxies the server's paths on the web app's origin).
# API_ORIGIN=
LOG_LEVEL=Info
DATABASE_URL=postgres://bluechip:bluechip@localhost:5432/bluechip
# Encrypts agents' session keys at rest: 32 random bytes, base64. Make one with `openssl rand -base64 32`; changing it
# makes existing agents' keys unreadable.
AGENT_KEY_ENCRYPTION_KEY=

# Network: `local` is the local chain `pnpm dev` runs (a copy of Base); `sepolia` is paper money on Base Sepolia
# (BASE_RPC_URL a Base Sepolia node); `base` is Base mainnet. The web app's VITE_NETWORK must match.
NETWORK=local
BASE_RPC_URL=http://localhost:8545
# Paper money only (NETWORK=sepolia, required there): the operator's key, the deployment's `paper.operator`. It mints
# the faucet's test USDC and writes the price feeds from Alpaca's prices; keep some Sepolia ETH on it (a warning is
# logged under 0.05 ETH).
# OPERATOR_PRIVATE_KEY=

# Bundler: `local` (Alto at BUNDLER_URL) or `alchemy` (its endpoints follow NETWORK: Base, or Base Sepolia on paper).
BUNDLER=local
BUNDLER_URL=http://localhost:4337
# Who pays gas: `none` (the account, in ETH), `alchemy-bso` (Alchemy's bundler) or `alchemy-paymaster`.
GAS_SPONSORSHIP=none
# ALCHEMY_API_KEY=
# ALCHEMY_GAS_POLICY_ID=

# Alpaca market data (server only). Free plan: one live stream per account, so use separate keys for local and
# production. Keys: app.alpaca.markets → Paper account → API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# The assistant (Anthropic). Only needed to talk to it; tests run on recorded models.
ANTHROPIC_API_KEY=
# The conversation model (answers and memory notes, retried when overloaded), and the small one for titles.
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_SMALL_MODEL=claude-haiku-5-5
# Each user's assistant budget per UTC day, in dollars of model cost.
ASSISTANT_DAILY_BUDGET=1

# Embeddings for the assistant's recall and bluechip's help (Voyage AI, dashboard.voyageai.com → API keys). Tests and
# the browser suite use a deterministic embedder instead. Changing the model re-embeds everything in the background.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4

# Web push (VAPID). Make the key pair with `node scripts/bin.ts vapid --env apps/server/.env.local`; never commit it.
# Changing it makes every browser subscribe again. Without keys, push is off and the app hides it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services contact about this server's pushes: a `mailto:` or a URL. The app's origin when empty.
# VAPID_SUBJECT=mailto:ops@example.com

# The Telegram bot (@BotFather → /newbot). Without a token the bot is off.
TELEGRAM_BOT_TOKEN=
# Its handle without `@`, for link codes' deep links.
TELEGRAM_BOT_USERNAME=
# How updates arrive: `polling` (the default outside production: no public URL needed) or `webhook` (the default in
# production: Telegram posts to TELEGRAM_WEBHOOK_URL, API_ORIGIN/telegram/webhook by default).
# TELEGRAM_UPDATES=polling
# The webhook's secret header: 32 to 256 of A-Za-z0-9_- (`openssl rand -hex 32`).
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=

# Reconciliation compares every account's balances on chain with its ledger every 5 minutes (deposits, alerts).
# RECONCILE_ENABLED=true
# Every schedule and watcher that sweeps everyone's rows (crons, automation watchers, the ledger's repair at start);
# tests turn them off.
# SCHEDULES_ENABLED=true

# Telemetry (Axiom) and analytics (PostHog): only on `paper` and `production`; `development` (the default) exports
# nothing and the browser's telemetry route answers 204 (`/api/sync/*`).
# DEPLOYMENT_ENVIRONMENT=development
# Axiom's ingest token (it may only ingest), the datasets' edge for ingest (`AXIOM_DOMAIN`, the API's host, when
# unset) and a dataset per signal (traces and logs Events, metrics Metrics). All of them, or no export.
# AXIOM_TOKEN=
# AXIOM_DOMAIN=api.axiom.co
# AXIOM_EDGE_DOMAIN=eu-central-1.aws.edge.axiom.co
# AXIOM_TRACES_DATASET=bluechip-traces
# AXIOM_LOGS_DATASET=bluechip-logs
# AXIOM_METRICS_DATASET=bluechip-metrics
# The share of GET requests traced, 0 to 1 (0.2 on production, 1 elsewhere). The browser's sampled flag wins.
# TRACE_SAMPLE_READS=1
# PostHog's ingest host the server's analytics posts to (US cloud).
# POSTHOG_HOST=https://us.i.posthog.com
# Product analytics from the server (PostHog), only on `paper` and `production` with the project's key: the
# catalogue's server events and LLM analytics, batched to POSTHOG_HOST. The personal key (scope `person:write`) deletes
# a person when their account is deleted; the project id is read from it when unset.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# LLM analytics carries prompts and answers only when this is on (a local debugging session, never paper or production).
# LLM_ANALYTICS_CAPTURE_TEXT=false
