{
  "name": "bluechip",
  "version": "0.0.0",
  "private": true,
  "description": "AI agents that trade tokenized stocks on Base within onchain permission policies.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc -b tsconfig.packages.json && pnpm --recursive --parallel --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm circular && pnpm test",
    "circular": "node scripts/bin.ts circular",
    "clean": "node scripts/bin.ts clean",
    "dev": "node scripts/bin.ts dev up",
    "dev:stop": "node scripts/bin.ts dev down",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --deny-warnings && node scripts/bin.ts lint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install && effect-tsgo patch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "effect-tsgo tsrs -b tsconfig.json && pnpm --recursive --filter \"./apps/*\" run typecheck",
    "typecheck:tsc": "tsc -b tsconfig.json && pnpm --recursive --filter \"./apps/*\" run typecheck",
    "devnet:capture": "node --env-file=.env.local scripts/bin.ts devnet capture",
    "test:fork": "BLUECHIP_FORK_TESTS=1 vitest run --project fork"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@effect-kit/oxc": "0.1.0",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@interfere/landmines": "0.3.1",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "5.1.1",
    "dprint": "0.65.0",
    "effect": "catalog:",
    "lefthook": "2.2.2",
    "oxlint": "1.95.0",
    "playwright": "1.65.1",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
