{
  "name": "@bluechip/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "bluechip's design system: tokens, components, motion and illustrations for the web app.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./src/styles/index.css",
    "./lib/*": "./src/lib/*.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./bluechip/*": "./src/bluechip/*.tsx",
    "./motion/*": "./src/motion/*.tsx",
    "./illustrations/*": "./src/illustrations/*.tsx"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/doto": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1"
  }
}
