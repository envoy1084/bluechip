{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@effect-kit/oxc/oxlintrc.json"
  ],
  "jsPlugins": [
    "@effect-kit/oxc/oxlint",
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    }
  ],
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.data",
    "tmp/**",
    "research/**",
    "**/.next/**",
    "**/.output/**",
    "**/routeTree.gen.ts"
  ],
  "rules": {
    "effect/no-import-from-barrel-package": [
      "error",
      {
        "checkPatterns": [
          "^effect$",
          "^effect/(.+/)?[a-z][a-z0-9]*$",
          "^@effect/[^/]+$",
          "^@effect/[^/]+/(.+/)?[a-z][a-z0-9]*$"
        ],
        "checkRelativeIndexImports": true
      }
    ],
    "landmines-testing/no-fixed-sleep": "error",
    "landmines-testing/no-flake-masking": "error",
    "landmines-testing/no-test-doubles": "error",
    "landmines-testing/no-unsignaled-poll": "error",
    "landmines-testing/strict-msw": "error"
  },
  "overrides": [
    {
      "files": [
        "**/{test,typetest,scripts,scratchpad}/**",
        "**/vitest.*.ts"
      ],
      "rules": {
        "effect/no-bigint-literals": "off",
        "eslint/no-console": "off",
        "effect/no-import-from-barrel-package": "off"
      }
    },
    {
      "files": [
        "**/test/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vitest",
                "message": "Import from @effect/vitest instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/ui/**/*.tsx",
        "apps/web/**/*.tsx"
      ],
      "plugins": [
        "react",
        "jsx-a11y",
        "react-perf"
      ],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react-perf/jsx-no-new-function-as-prop": "off"
      }
    },
    {
      "files": [
        "packages/ui/test/**",
        "apps/web/test/**"
      ],
      "rules": {
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off"
      }
    }
  ]
}
